{
  "expo": {
    "name": "ЛОТ",
    "slug": "lot-marketplace",
    "version": "0.1.6-beta.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lot",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.lot.marketplace.alpha"
    },
    "android": {
      "package": "ru.lot.marketplace.alpha",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#FF6B00",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "./plugins/withAndroidNetworkSecurity.js"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "releaseChannel": "closed-beta",
      "router": {
        "origin": false
      }
    }
  }
}
