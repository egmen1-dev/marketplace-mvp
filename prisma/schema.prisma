// Marketplace MVP — Prisma schema
// Domain models only; no business logic.
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

/// Состояние товара (новый / б/у / восстановленный)
enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum OrderStatus {
  NEW
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum DeliveryProvider {
  CDEK
  PICKUP
  OTHER
}

/// How the buyer wants the order delivered (CDEK ПВЗ vs courier).
enum DeliveryMethod {
  PICKUP
  COURIER
}

enum DeliveryStatus {
  PENDING
  CREATED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

/// Seller store type for catalog filters (shop vs private individual).
enum SellerKind {
  SHOP
  INDIVIDUAL
}

/// How the buyer receives goods: CDEK delivery vs seller warehouse pickup.
enum OrderFulfillmentType {
  DELIVERY
  SELLER_PICKUP
}

enum PickupReservationStatus {
  PENDING
  CONFIRMED
  READY
  COMPLETED
  CANCELLED
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum MessageType {
  TEXT
  SYSTEM
  IMAGE
  ORDER
  RESERVATION
}

/// Characteristic value types for ProductType schemas.
enum CharacteristicValueType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTISELECT
  COLOR
  SIZE
}

// ─── User & Seller ───────────────────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?
  name          String?
  phone         String?
  /// Buyer profile city (delivery / display)
  city          String?
  role          UserRole       @default(BUYER)
  /// Soft block — blocked users cannot sign in
  isBlocked     Boolean        @default(false)
  emailVerified DateTime?
  /// Avatar URL (Auth.js `image` field; used as profile avatarUrl)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sellerProfile        SellerProfile?
  addresses            Address[]
  cart                 Cart?
  orders               Order[]
  payments             Payment[]
  favorites            Favorite[]
  productViews         ProductView[]
  inventoryHistory     InventoryHistory[]
  orderStatusChanges   OrderStatusHistory[]
  adminActionLogs      AdminActionLog[]
  pickupReservations   PickupReservation[]
  buyerConversations   Conversation[]      @relation("ConversationBuyer")
  sentMessages         Message[]

  @@index([role])
  @@index([isBlocked])
  @@map("users")
}

model SellerProfile {
  id               String     @id @default(cuid())
  userId           String     @unique
  storeName        String
  slug             String     @unique
  description      String?
  logoUrl          String?
  phone            String?
  email            String?
  address          String?
  /// Free-text shipping defaults shown to buyers / used in cabinet
  shippingDefaults String?
  /// Aggregate store rating 0–5 (placeholder until reviews land)
  rating           Decimal    @default(0) @db.Decimal(3, 2)
  isVerified       Boolean    @default(false)
  /// Set when admin verifies the seller; cleared on unverify
  verifiedAt       DateTime?
  /// Admin-blocked store — hidden from public catalog listings
  isBlocked        Boolean    @default(false)
  /// SHOP = storefront; INDIVIDUAL = private seller
  kind             SellerKind @default(SHOP)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products       Product[]
  pickupPoints   PickupPoint[]
  reservations   PickupReservation[]
  conversations  Conversation[]

  @@index([slug])
  @@index([kind])
  @@index([isBlocked])
  @@map("seller_profiles")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  /// Display name in LOT (may differ from external source name)
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  /// Depth from root: 1 = root; unlimited nesting supported
  level       Int      @default(1)
  /// Materialized path of ancestor slugs, e.g. "construction/climate/heaters"
  path        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  /// External taxonomy source, e.g. "wildberries", "manual", "snapshot"
  externalSource String?
  /// External category / parent ID from source (NOT used as LOT primary key)
  externalId     String?
  /// Original name from external source (preserved across local renames)
  externalName   String?
  /// True when an admin locally overrode name/slug — sync must not overwrite
  locallyEdited  Boolean  @default(false)
  sourceUpdatedAt DateTime?
  lastSyncedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]    @relation("CategoryTree")
  products     Product[]
  productTypes ProductType[]
  aliases      CategoryAlias[]

  @@unique([externalSource, externalId])
  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@index([level])
  @@index([path])
  @@index([name])
  @@index([externalSource, externalId])
  @@index([parentId, level])
  @@map("categories")
}

/// Concrete product subject / type (e.g. "Тепловые пушки"), leaf of taxonomy.
model ProductType {
  id             String   @id @default(cuid())
  categoryId     String
  name           String
  /// LOT display name (defaults to name; admin may override)
  lotName        String?
  slug           String   @unique
  description    String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  externalSource String?
  externalId     String?
  externalName   String?
  locallyEdited  Boolean  @default(false)
  sourceUpdatedAt DateTime?
  lastSyncedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category         Category                        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products         Product[]
  characteristics  ProductCharacteristicDefinition[]
  aliases          ProductTypeAlias[]

  @@unique([externalSource, externalId])
  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@index([name])
  @@index([externalSource, externalId])
  @@map("product_types")
}

model CategoryAlias {
  id         String   @id @default(cuid())
  categoryId String
  alias      String
  /// Normalized lowercase form for matching
  normalized String
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, normalized])
  @@index([normalized])
  @@map("category_aliases")
}

model ProductTypeAlias {
  id            String   @id @default(cuid())
  productTypeId String
  alias         String
  normalized    String
  createdAt     DateTime @default(now())

  productType ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@unique([productTypeId, normalized])
  @@index([normalized])
  @@map("product_type_aliases")
}

model ProductCharacteristicDefinition {
  id            String                  @id @default(cuid())
  productTypeId String
  name          String
  slug          String
  type          CharacteristicValueType @default(TEXT)
  required      Boolean                 @default(false)
  unit          String?
  /// JSON array of allowed options for SELECT / MULTISELECT
  options       Json?
  sortOrder     Int                     @default(0)
  /// Use as catalog filter when true
  filterable    Boolean                 @default(false)
  externalId    String?
  externalSource String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  productType ProductType                   @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  values      ProductCharacteristicValue[]

  @@unique([productTypeId, slug])
  @@unique([externalSource, externalId])
  @@index([productTypeId])
  @@index([slug])
  @@index([filterable])
  @@map("product_characteristic_definitions")
}

model ProductCharacteristicValue {
  id             String   @id @default(cuid())
  productId      String
  definitionId   String
  /// Stored as string; NUMBER/BOOLEAN parsed at validation layer
  valueText      String?
  valueNumber    Decimal? @db.Decimal(18, 4)
  valueBoolean   Boolean?
  /// JSON for MULTISELECT arrays
  valueJson      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    Product                          @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition ProductCharacteristicDefinition  @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([productId, definitionId])
  @@index([productId])
  @@index([definitionId])
  @@map("product_characteristic_values")
}

model Product {
  id             String           @id @default(cuid())
  sellerId       String
  categoryId     String?
  /// Concrete subject/type; null until mapped (existing products stay valid)
  productTypeId  String?
  name           String
  slug           String
  description    String?
  sku            String?
  price          Decimal          @db.Decimal(12, 2)
  compareAt      Decimal?         @db.Decimal(12, 2)
  currency       String           @default("RUB")
  /// Kept in sync with ProductInventory.quantity for catalog/cart compatibility
  stock          Int              @default(0)
  /// Weight in kilograms
  weight         Decimal?         @db.Decimal(10, 3)
  /// Package dimensions in centimeters
  lengthCm       Decimal?         @db.Decimal(10, 2)
  widthCm        Decimal?         @db.Decimal(10, 2)
  heightCm       Decimal?         @db.Decimal(10, 2)
  /// @deprecated (TASK 058) — SEO metadata is derived from title/description +
  /// taxonomy via ProductSearchDocumentBuilder. Column kept for back-compat.
  seoTitle       String?
  /// @deprecated (TASK 058) — derived; not seller-authored anymore.
  seoDescription String?
  city           String?
  condition      ProductCondition @default(NEW)
  status         ProductStatus    @default(DRAFT)
  /// PDP / listing popularity signal
  views          Int              @default(0)
  /// Soft counter for hit badge / popular sort — kept in sync with Favorite rows
  favoritesCount Int              @default(0)
  /// Seller warehouse pickup available for this product
  pickupEnabled       Boolean @default(false)
  /// Buyer can reserve / prepay before pickup
  reservationEnabled  Boolean @default(false)
  /// Prepayment percent of line total (0–100); allowed: 0,10,20,30,50,100
  prepaymentPercent   Int     @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  seller           SellerProfile         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category         Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productType      ProductType?          @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  favorites        Favorite[]
  viewsLog         ProductView[]
  inventory        ProductInventory?
  inventoryHistory InventoryHistory[]
  pickupPoints     ProductPickupPoint[]
  reservations     PickupReservation[]
  conversations    Conversation[]
  characteristicValues ProductCharacteristicValue[]
  rankingStats     ProductRankingStats?

  @@unique([sellerId, slug])
  @@index([sellerId])
  @@index([categoryId])
  @@index([productTypeId])
  @@index([status])
  @@index([condition])
  @@index([city])
  @@index([name])
  @@index([price])
  @@index([views])
  @@index([favoritesCount])
  @@index([createdAt])
  @@index([pickupEnabled])
  @@map("products")
}

/// Canonical sellable quantity; Product.stock mirrors `quantity`.
model ProductInventory {
  id               String   @id @default(cuid())
  productId        String   @unique
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0)
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_inventories")
}

model InventoryHistory {
  id            String   @id @default(cuid())
  productId     String
  delta         Int
  quantityAfter Int
  note          String?
  createdAt     DateTime @default(now())
  actorUserId   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
  @@index([actorUserId])
  @@map("inventory_history")
}

/// Authenticated buyer favorites (unique per user+product).
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}

/// Recently viewed products for authenticated buyers (one row per user+product).
model ProductView {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("product_views")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  /// Storage pathname (e.g. products/{sellerId}/{uuid}.jpg) for ownership checks
  pathname  String?
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([pathname])
  @@map("product_images")
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

// ─── Orders & Payments ───────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  userId          String
  orderNumber     String      @unique
  status          OrderStatus @default(NEW)
  subtotal        Decimal     @db.Decimal(12, 2)
  shippingCost    Decimal     @default(0) @db.Decimal(12, 2)
  /// Amount charged now (full for delivery; prepayment sum for seller pickup)
  total           Decimal     @db.Decimal(12, 2)
  currency        String      @default("RUB")
  shippingAddressId String?
  notes           String?
  fulfillmentType OrderFulfillmentType @default(DELIVERY)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingAddress Address?            @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payment         Payment?
  delivery        Delivery?
  statusHistory   OrderStatusHistory[]
  reservations    PickupReservation[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([fulfillmentType])
  @@map("orders")
}

model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
  @@index([changedByUserId])
  @@map("order_status_history")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  productSku  String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  totalPrice  Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  userId                String
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("RUB")
  status                PaymentStatus @default(PENDING)
  // Stripe Checkout Session + PaymentIntent ids
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  stripeClientSecret    String?
  stripeChargeId        String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([stripeSessionId])
  @@index([stripePaymentIntentId])
  @@map("payments")
}

// ─── Address & Delivery ──────────────────────────────────────────────────────

model Address {
  id         String      @id @default(cuid())
  userId     String
  type       AddressType @default(SHIPPING)
  label      String?
  fullName   String
  phone      String?
  country    String      @default("RU")
  region     String?
  city       String
  street     String
  building   String?
  apartment  String?
  postalCode String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

/// CDEK (or other) delivery for an order — created at checkout before payment.
model Delivery {
  id                String           @id @default(cuid())
  orderId           String           @unique
  provider          DeliveryProvider @default(CDEK)
  method            DeliveryMethod   @default(COURIER)
  status            DeliveryStatus   @default(PENDING)
  cost              Decimal          @default(0) @db.Decimal(12, 2)
  currency          String           @default("RUB")
  trackingNumber    String?
  trackingUrl       String?
  /// CDEK ПВЗ code when method = PICKUP
  pickupPointId     String?
  pickupAddress     String?
  estimatedMinDays  Int?
  estimatedMaxDays  Int?
  // CDEK / provider external refs (nullable until shipment created)
  externalId        String?
  externalStatus    String?
  estimatedDelivery DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider])
  @@index([status])
  @@index([method])
  @@index([trackingNumber])
  @@map("deliveries")
}

// ─── Seller pickup & reservations ────────────────────────────────────────────

model PickupPoint {
  id            String   @id @default(cuid())
  sellerId      String
  name          String
  city          String
  address       String
  description   String?
  phone         String?
  workingHours  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seller       SellerProfile         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  products     ProductPickupPoint[]
  reservations PickupReservation[]

  @@index([sellerId])
  @@index([sellerId, isActive])
  @@index([city])
  @@map("pickup_points")
}

model ProductPickupPoint {
  productId     String
  pickupPointId String

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  pickupPoint PickupPoint @relation(fields: [pickupPointId], references: [id], onDelete: Cascade)

  @@id([productId, pickupPointId])
  @@index([pickupPointId])
  @@map("product_pickup_points")
}

model PickupReservation {
  id                 String                  @id @default(cuid())
  orderId            String
  productId          String
  buyerId            String
  sellerId           String
  pickupPointId      String
  status             PickupReservationStatus @default(PENDING)
  quantity           Int                     @default(1)
  prepaymentPercent  Int                     @default(0)
  prepaymentAmount   Decimal                 @db.Decimal(12, 2)
  remainingAmount    Decimal                 @db.Decimal(12, 2)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer       User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  pickupPoint PickupPoint @relation(fields: [pickupPointId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([pickupPointId])
  @@index([status])
  @@index([createdAt])
  @@map("pickup_reservations")
}

// ─── Chat (buyer ↔ seller) ───────────────────────────────────────────────────

/// One conversation per buyer+product. sellerId is SellerProfile.id.
model Conversation {
  id        String             @id @default(cuid())
  productId String
  buyerId   String
  sellerId  String
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer    User          @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([productId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
  @@index([status])
  @@index([updatedAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  /// Null for SYSTEM messages without a human sender.
  senderId       String?
  text           String
  type           MessageType @default(TEXT)
  isRead         Boolean     @default(false)
  /// Future attachments (images / documents / receipts).
  attachmentUrl  String?
  attachmentName String?
  attachmentMime String?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([conversationId, isRead])
  @@map("messages")
}

// ─── Admin audit ─────────────────────────────────────────────────────────────

/// Simple audit trail for marketplace owner actions (no secrets / payments).
model AdminActionLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  /// Optional non-sensitive metadata (JSON string)
  meta       String?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_action_logs")
}

// ─── Ranking & taxonomy sync (TASK 058) ──────────────────────────────────────

/// Precomputed marketplace ranking signals per product (section 39).
/// Real data only — no fake ratings/orders/buyouts. Refreshed by an aggregator.
model ProductRankingStats {
  productId       String   @id
  /// Distinct PDP views / impressions.
  views           Int      @default(0)
  /// Paid orders count (excludes cancelled/unpaid).
  orders          Int      @default(0)
  /// Completed (received) orders count.
  completedOrders Int      @default(0)
  /// Units ordered in paid orders.
  unitsOrdered    Int      @default(0)
  /// Units actually bought out / received.
  unitsBoughtOut  Int      @default(0)
  revenue         Decimal  @default(0) @db.Decimal(14, 2)
  /// Derived rate (nullable → cold start uses priors at score time).
  conversionRate  Decimal? @db.Decimal(6, 5)
  buyoutRate      Decimal? @db.Decimal(6, 5)
  /// Real reviews only.
  avgRating       Decimal? @db.Decimal(3, 2)
  ratingCount     Int      @default(0)
  /// Last computed organic score + engine version.
  organicScore    Decimal? @db.Decimal(6, 5)
  rankingVersion  String?
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organicScore])
  @@map("product_ranking_stats")
}

enum TaxonomySyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// One taxonomy sync run's metadata for reporting/observability (sections 10/39).
model TaxonomySyncRun {
  id                      String             @id @default(cuid())
  source                  String
  /// "live" (WB API) or "snapshot".
  mode                    String
  status                  TaxonomySyncStatus @default(RUNNING)
  categoriesImported      Int                @default(0)
  productTypesImported    Int                @default(0)
  characteristicsImported Int                @default(0)
  aliasesImported         Int                @default(0)
  created                 Int                @default(0)
  updated                 Int                @default(0)
  deactivated             Int                @default(0)
  errorText               String?
  durationMs              Int                @default(0)
  startedAt               DateTime           @default(now())
  finishedAt              DateTime?

  @@index([source])
  @@index([startedAt])
  @@map("taxonomy_sync_runs")
}
