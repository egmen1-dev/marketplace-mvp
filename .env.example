# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/marketplace?schema=public"

# Stripe Checkout (optional — leave empty to skip payments; checkout shows a clear error)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# CDEK delivery — leave empty to use mock (deterministic PVZ + quotes)
CDEK_CLIENT_ID=""
CDEK_CLIENT_SECRET=""
CDEK_API_URL="https://api.edu.cdek.ru/v2"
# Optional warehouse city code (44 = Moscow). Used by real calculator.
CDEK_FROM_CITY_CODE=""

# Auth.js (NextAuth v5) — REQUIRED. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Vercel Blob — product image uploads (Storage → Blob in Vercel dashboard)
# Local: `vercel env pull` after linking the project, or paste the RW token.
BLOB_READ_WRITE_TOKEN=""
