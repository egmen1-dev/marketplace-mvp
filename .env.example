# ─── Required ───────────────────────────────────────────────────────────────
# Use one host consistently (prefer localhost over 127.0.0.1)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional Auth.js URL (defaults to NEXT_PUBLIC_APP_URL / request host with trustHost)
# AUTH_URL="http://localhost:3000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/marketplace?schema=public"

# Auth.js (NextAuth v5) — REQUIRED. Generate with: openssl rand -base64 32
# Never commit the real secret. Never log AUTH_SECRET.
AUTH_SECRET=""

# ─── Storage ────────────────────────────────────────────────────────────────
# Provider: vercel-blob (default). Future: s3 | r2 | supabase (see lib/storage)
STORAGE_PROVIDER="vercel-blob"

# Vercel Blob — product image uploads (works from any host if token is set)
# Vercel Dashboard → Storage → Blob, or reconnect store / `vercel env pull`
BLOB_READ_WRITE_TOKEN=""
# private (default) | public — must match the Blob store access mode
BLOB_ACCESS="private"
NEXT_PUBLIC_BLOB_ACCESS="private"

# ─── Payment (Stripe, optional) ─────────────────────────────────────────────
# Leave empty to skip payments; checkout shows a clear error
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Trust & Safety (optional — default off) ────────────────────────────────
# TRUST_SAFETY_ENABLED=true
# NEXT_PUBLIC_TRUST_SAFETY_ENABLED=true

# ─── Delivery (CDEK, optional) ──────────────────────────────────────────────
# Leave empty to use mock (deterministic PVZ + quotes)
CDEK_CLIENT_ID=""
CDEK_CLIENT_SECRET=""
CDEK_API_URL="https://api.edu.cdek.ru/v2"
# Optional warehouse city code (44 = Moscow). Used by real calculator.
CDEK_FROM_CITY_CODE=""

# ─── E2E fixtures (local + Railway staging only) ─────────────────────────────
# Required for deterministic pickup Playwright fixtures (`/api/e2e/pickup-fixture`).
# Generate: openssl rand -hex 24
# Never commit the real value. Do not set on Vercel production unless you intend to.
E2E_FIXTURE_SECRET=""

# Railway / external cron for OMS overdue processor (Bearer or x-cron-secret)
CRON_SECRET=""

# ─── Error monitoring (optional — wire on production GO) ─────────────────────
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="staging"
# NEXT_PUBLIC_SENTRY_DSN=""   # client-side (after @sentry/nextjs wizard)

# ─── Backup hosts (optional URL fallbacks; prefer NEXT_PUBLIC_APP_URL) ───────
# RENDER_EXTERNAL_URL is set automatically on Render
# RAILWAY_PUBLIC_DOMAIN is set automatically on Railway
# APP_ENV=staging on Railway; APP_ENV=production on Vercel prod (optional override)
# GIT_COMMIT / BUILD_TIME — set at build (see scripts/write-build-info.mjs)
# See docs/BACKUP_DEPLOYMENT.md and docs/DEPLOYMENT_FLOW.md

# ─── Marketplace Discovery (optional) ───────────────────────────────────────
# MARKETPLACE_DISCOVERY_ENABLED=true
# DISCOVERY_DAILY_FINDS_ENABLED=true
# DISCOVERY_COLLECTIONS_ENABLED=true
# DISCOVERY_PRICE_GAME_ENABLED=true
# DISCOVERY_AI_CONTEXT_ENABLED=true

# ─── Marketplace Social Growth (optional) ───────────────────────────────────
# MARKETPLACE_SOCIAL_GROWTH_ENABLED=true
# SOCIAL_SHARE_CARDS_ENABLED=true
# SOCIAL_COLLECTIONS_ENABLED=true
# SOCIAL_CREATOR_ENABLED=true

# ─── Marketplace UX Completion (optional) ───────────────────────────────────
# MARKETPLACE_UX_COMPLETION_ENABLED=true

# ─── Marketplace Conversion Audit (optional) ────────────────────────────────
# MARKETPLACE_CONVERSION_ENABLED=true

# ─── Marketplace Content Quality Intelligence (optional) ───────────────────
# MARKETPLACE_CONTENT_QUALITY_ENABLED=true
# MARKETPLACE_CONTENT_QUALITY_DAOS_ENABLED=true
# DAOS_QUALITY_API_URL=""
# DAOS_QUALITY_API_KEY=""
# DAOS_QUALITY_TIMEOUT_MS="8000"

# ─── CCOS Wave 0 (optional — default off, zero behaviour change when off) ───
# CCOS_ENABLED=false
# MARKETPLACE_COGNITIVE_PLATFORM_ENABLED=false
